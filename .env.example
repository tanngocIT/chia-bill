# Leave empty to run without a backend (data is kept in the browser and
# shared through the link itself). Fill both to use Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public base URL used when building share links, e.g.
# https://<your-user>.github.io/chia-bill/  (optional, defaults to current page)
VITE_PUBLIC_URL=
